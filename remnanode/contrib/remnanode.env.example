# Required.
NODE_PORT=50415
SECRET_KEY=
INTERNAL_REST_TOKEN=

# Optional.
XRAY_CORE_VERSION=
XRAY_BINARY_PATH=/usr/local/bin/rw-core
XTLS_API_PORT=61000
DISABLE_HASHED_SET_CHECK=false
# Set DEBUG=true to log every API request and response body (for troubleshooting).
# Gzip-compressed bodies are automatically decompressed in the log.
DEBUG=false
