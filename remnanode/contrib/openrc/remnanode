#!/sbin/openrc-run

name="remnanode"
description="Remnawave Node (Go)"
command="/usr/local/bin/remnanode"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/remnanode.log"
error_log="/var/log/remnanode.err.log"

# Put required variables (SECRET_KEY, NODE_PORT, INTERNAL_REST_TOKEN)
# and optional ones in:  /etc/conf.d/remnanode
# See contrib/remnanode.env.example for the full list.

depend() {
	need net
	after firewall
}
